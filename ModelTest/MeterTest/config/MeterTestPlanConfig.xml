<?xml version="1.0" encoding="utf-8"?>
<!--
  MeterTest 测试方案配置说明
  1. ControlPcbGroups 配置控制 PCB 通信关系：
     - 一个 ControlPcbGroup 表示一个控制 PCB 的 IP/Port。
     - stationStart/stationEnd 表示这个 PCB 管辖界面上的工位范围。
     - meterAddressStart 表示 stationStart 对应的 PCB 表位地址；后续表位按顺序递增。
       例：stationStart=11, stationEnd=20, meterAddressStart=1，表示界面工位11发 PCB 地址01，工位20发 PCB 地址0A。
     - protocolVersion 支持 V1 / V2；V2 使用 55 44 ... AA BB，协议类型为 0x02；V1 使用 55 ... AA，协议类型为 0x00。
  2. SourceControlConfigs 配置升源关系：
     - 一个 SourceControlConfig 表示一套源参数。
     - phaseMode 支持 SinglePhase / ThreePhase。
     - interfaceType 支持 AnyUIOutput / Adj / RangeOutputUI / ShutPowerSource。
     - AnyUIOutput 参数格式：Ua_Ub_Uc_Ia_Ib_Ic_IAJ_IBJ_ICJ_Uab_Uac。
     - SinglePhase 默认只升 A 相；ThreePhase 默认 ABC 三相都使用 voltage/current。
     - TestSubItem 通过 sourceControlConfig 引用配置名称；为空表示执行该测试小项前不自动升源。
  3. Scheme/TestItem/TestSubItem 对应界面左侧方案树：方案 -> 测试项 -> 测试小项。
  4. executionMode 决定测试小项的执行目标：
     - StationTcp：使用界面工位表格中的 IP/Port，一工位一连接，适合 698 地址读取。
     - ControlPcbDailyTiming：不使用界面工位 IP/Port，改用 ControlPcbGroups 中的控制 PCB 关系，适合台体日计时。
  5. ControlPcbDailyTiming 日计时流程：
     - 对选中的工位，根据 ControlPcbGroups 找到对应 PCB 和表位地址。
     - 发送命令 0x36 + 0x00 + dailyTimingTime + dailyTimingCount 开始日计时。
     - 每条报文按 packetIntervalMs 间隔发送，默认 100ms。
     - 没有开始应答的表位标记失败，不影响其他已应答表位继续等待和结果获取。
     - 等待 dailyTimingTime * dailyTimingCount + dailyTimingCount 秒后，发送 0x36 + 0xAA + dailyTimingTime + dailyTimingCount 获取结果。
  6. StationTcp 地址读取：
     - requestHex 是下发 698 报文，timeoutMs 是等待响应超时时间。
     - responseParser=Sgcc698BroadcastAddress 时，会校验起止符、长度、HCS、APDU、OAD、数据类型、数据长度和 FCS，并提取表位地址。
-->
<MeterTestPlanConfig xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <SourceControlConfigs>
    <SourceControlConfig
      name="单相默认源"
      enabled="true"
      phaseMode="SinglePhase"
      interfaceType="AnyUIOutput"
      sourcePort="1"
      openCommBeforeOutput="true"
      voltage="220"
      current="5"
      currentAngleA="0"
      currentAngleB="0"
      currentAngleC="0"
      uab="120"
      uac="240"
      phase="A"
      powerFactor="1.0"
      pulse="2"
      description="单相默认升源配置，默认 A 相输出" />
    <SourceControlConfig
      name="三相默认源"
      enabled="true"
      phaseMode="ThreePhase"
      interfaceType="AnyUIOutput"
      sourcePort="1"
      openCommBeforeOutput="true"
      voltage="220"
      current="5"
      currentAngleA="0"
      currentAngleB="0"
      currentAngleC="0"
      uab="120"
      uac="240"
      phase="H"
      powerFactor="1.0"
      pulse="2"
      description="三相默认升源配置，ABC 三相同电压同电流输出" />
  </SourceControlConfigs>

  <ControlPcbGroups>
    <ControlPcbGroup name="控制PCB-1" enabled="true" ip="192.168.127.101" port="4001" protocolVersion="V2" stationStart="1" stationEnd="3" meterAddressStart="1" />
    <ControlPcbGroup name="控制PCB-2" enabled="true" ip="192.168.127.101" port="4002" protocolVersion="V2" stationStart="4" stationEnd="6" meterAddressStart="4" />
    <ControlPcbGroup name="控制PCB-3" enabled="true" ip="192.168.127.101" port="4003" protocolVersion="V2" stationStart="7" stationEnd="9" meterAddressStart="7" />
    <ControlPcbGroup name="控制PCB-4" enabled="true" ip="192.168.127.101" port="4004" protocolVersion="V2" stationStart="10" stationEnd="12" meterAddressStart="10" />
    <ControlPcbGroup name="控制PCB-5" enabled="true" ip="192.168.127.101" port="4005" protocolVersion="V2" stationStart="13" stationEnd="15" meterAddressStart="13" />
    <ControlPcbGroup name="控制PCB-6" enabled="true" ip="192.168.127.101" port="4006" protocolVersion="V2" stationStart="16" stationEnd="18" meterAddressStart="16" />
    <ControlPcbGroup name="控制PCB-7" enabled="true" ip="192.168.127.101" port="4007" protocolVersion="V2" stationStart="19" stationEnd="20" meterAddressStart="19" />
    <!--
      多个控制 PCB 映射工位配置：
      4001 控制 1-3 表位，4002 控制 4-6 表位，后续端口依次递增。
      meterAddressStart 与 stationStart 保持一致，表示工位号和 PCB 表位地址一致。
    -->
  </ControlPcbGroups>

  <Scheme name="默认方案" description="MeterTest 默认测试方案，所有测试内容从本配置文件加载">
    <TestItem name="通信测试" description="读取表位地址">
      <TestSubItem
        name="地址读取"
        enabled="true"
        protocol="DLT698.45"
        executionMode="StationTcp"
        sourceControlConfig="三相默认源"
        description="广播读取表位地址；响应必须是698读取响应，OAD=40010200，数据为6字节地址"
        requestHex="68 17 00 43 05 AA AA AA AA AA AA 10 2B 3A 05 01 71 40 01 02 00 00 C7 C2 16"
        responseParser="Sgcc698BroadcastAddress"
        expectedApdu="85 01"
        expectedOad="40 01 02 00"
        expectedDataType="09"
        expectedDataLength="6"
        resultField="MeterAddress"
        expectedResponse=""
        responseMatchMode="Contains"
        timeoutMs="5000"
        mockResponse="68 21 00 C3 05 96 81 32 02 00 90 A0 F5 F6 85 01 00 40 01 02 00 01 09 06 90 00 02 32 81 96 00 00 BA 13 16" />
    </TestItem>

    <TestItem name="日计时" description="通过控制PCB执行多表位日计时">
      <TestSubItem
        name="日计时"
        enabled="true"
        protocol="MeterControlPcb"
        executionMode="ControlPcbDailyTiming"
        controlPcbGroup=""
        sourceControlConfig="三相默认源"
        description="控制PCB日计时：开始、等待、结果获取；为空表示使用所有启用的 ControlPcbGroup"
        requestHex=""
        responseParser="MeterControlDailyTiming"
        expectedApdu=""
        expectedOad=""
        expectedDataType=""
        expectedDataLength="0"
        resultField=""
        expectedResponse=""
        responseMatchMode="Contains"
        dailyTimingTime="10"
        dailyTimingCount="10"
        packetIntervalMs="100"
        timeoutMs="5000"
        mockResponse="" />
    </TestItem>
  </Scheme>
</MeterTestPlanConfig>
